# Copy this file to `.env.local` (gitignored) and fill in the values.

# Python/FastAPI backend (backend/ in this repo) — order dispatch, the Goer
# chatbot (its whole agent pipeline), and push notifications all go through it. Use your machine's LAN
# IP (not localhost) so a physical device running Expo Go can reach it.
# Leaving it blank runs the app without a backend: checkout still works
# locally, Goer uses the on-device rule-based assistant.
EXPO_PUBLIC_API_URL=

# Supabase (Auth + realtime only — data access goes through the backend).
# Copy the values from your Supabase project: Dashboard -> Settings -> API.
# These MUST match LocalGODriverRN/.env.local, same project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Goer chatbot: force the on-device rule-based assistant even when the
# backend is reachable (useful for offline demos/testing).
# The GROQ_API_KEY itself is NEVER set here — it lives only in the
# backend's .env (see backend/.env.example).
EXPO_PUBLIC_GOER_FORCE_FALLBACK=
