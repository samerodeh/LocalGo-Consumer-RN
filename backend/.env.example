# LocalGO FastAPI backend — copy to `.env` (gitignored) and fill in.
#
# Supabase project shared by BOTH apps (same values as the apps' .env.local,
# without the EXPO_PUBLIC_ prefix). Dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key (Dashboard -> API -> service_role). Only needed for push
# notifications (/notify) — the backend derives recipients from live order
# state, which requires bypassing RLS. Leave blank to disable push.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the Goer chat proxy (/goer/chat). Leave blank and the
# consumer app simply stays in offline-NLU mode.
ANTHROPIC_API_KEY=
# Optional model override for Goer.
GOER_MODEL=claude-haiku-4-5
