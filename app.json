{
  "expo": {
    "name": "LocalGOConsumerRN",
    "slug": "LocalGOConsumerRN",
    "version": "1.0.0",
    "scheme": "localgo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.samerodeh.localgoconsumer"
    },
    "android": {
      "package": "com.samerodeh.localgoconsumer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalGO uses your location to detect your current delivery address."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F97316"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "LocalGO uses your microphone to record voice messages in chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LocalGO uses your photos to attach pictures in chat."
        }
      ],
      "@stripe/stripe-react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62df4e41-4483-4c59-acc1-a39c1d45b627"
      }
    }
  }
}

